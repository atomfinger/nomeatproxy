{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "translation.schema.json",
	"title": "Translation",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"lang",
		"title",
		"description",
		"ogSiteName",
		"ogImageAlt",
		"brand",
		"hook",
		"example1",
		"example2",
		"whyMatters",
		"share",
		"footer"
	],
	"properties": {
		"lang": { "type": "string", "minLength": 1 },
		"dir": { "enum": ["ltr", "rtl"] },
		"title": { "type": "string", "minLength": 1 },
		"description": { "type": "string", "minLength": 1 },
		"ogSiteName": { "type": "string", "minLength": 1 },
		"ogImageAlt": { "type": "string", "minLength": 1 },
		"hook": { "type": "string", "minLength": 1 },
		"brand": {
			"type": "object",
			"additionalProperties": false,
			"required": ["logoAlt"],
			"properties": {
				"logoAlt": { "type": "string", "minLength": 1 }
			}
		},
		"example1": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"heading", "dontLabel", "doLabel", "question", "dontAnswer", "doAnswer",
				"paragraph1", "paragraph2", "consequencesIntro", "consequences",
				"avoidHeading", "avoidList", "insteadHeading", "insteadList", "closing"
			],
			"properties": {
				"heading": { "type": "string", "minLength": 1 },
				"dontLabel": { "type": "string", "pattern": "^✕ .+" },
				"doLabel": { "type": "string", "pattern": "^✓ .+" },
				"question": { "type": "string", "minLength": 1 },
				"dontAnswer": { "type": "string", "minLength": 1 },
				"doAnswer": { "type": "string", "minLength": 1 },
				"paragraph1": { "type": "string", "minLength": 1 },
				"paragraph2": { "type": "string", "minLength": 1 },
				"consequencesIntro": { "type": "string", "minLength": 1 },
				"consequences": {
					"type": "array",
					"minItems": 5,
					"maxItems": 5,
					"items": { "type": "string", "minLength": 1 }
				},
				"avoidHeading": { "type": "string", "minLength": 1 },
				"avoidList": {
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": { "type": "string", "minLength": 1 }
				},
				"insteadHeading": { "type": "string", "minLength": 1 },
				"insteadList": {
					"type": "array",
					"minItems": 3,
					"maxItems": 3,
					"items": { "type": "string", "minLength": 1 }
				},
				"closing": { "type": "string", "minLength": 1 }
			}
		},
		"example2": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"heading", "dontLabel", "doLabel", "reviewComment1", "dontReviewComment2",
				"doReviewComment2", "paragraph1", "consequencesIntro", "consequences",
				"avoidHeading", "avoidList", "insteadHeading", "insteadList", "closing"
			],
			"properties": {
				"heading": { "type": "string", "minLength": 1 },
				"dontLabel": { "type": "string", "pattern": "^✕ .+" },
				"doLabel": { "type": "string", "pattern": "^✓ .+" },
				"reviewComment1": { "type": "string", "minLength": 1 },
				"dontReviewComment2": { "type": "string", "minLength": 1 },
				"doReviewComment2": { "type": "string", "minLength": 1 },
				"paragraph1": { "type": "string", "minLength": 1 },
				"consequencesIntro": { "type": "string", "minLength": 1 },
				"consequences": {
					"type": "array",
					"minItems": 5,
					"maxItems": 5,
					"items": { "type": "string", "minLength": 1 }
				},
				"avoidHeading": { "type": "string", "minLength": 1 },
				"avoidList": {
					"type": "array",
					"minItems": 4,
					"maxItems": 4,
					"items": { "type": "string", "minLength": 1 }
				},
				"insteadHeading": { "type": "string", "minLength": 1 },
				"insteadList": {
					"type": "array",
					"minItems": 4,
					"maxItems": 4,
					"items": { "type": "string", "minLength": 1 }
				},
				"closing": { "type": "string", "minLength": 1 }
			}
		},
		"whyMatters": {
			"type": "object",
			"additionalProperties": false,
			"required": ["heading", "originalInspirationNote"],
			"properties": {
				"heading": { "type": "string", "minLength": 1 },
				"originalInspirationNote": { "type": "string", "pattern": "^ \\(.+\\)$" }
			}
		},
		"share": {
			"type": "object",
			"additionalProperties": false,
			"required": ["prompt", "copyLabel", "copiedLabel", "secondary"],
			"properties": {
				"prompt": { "type": "string", "minLength": 1 },
				"copyLabel": { "type": "string", "minLength": 1 },
				"copiedLabel": { "type": "string", "minLength": 1 },
				"secondary": { "type": "string", "minLength": 1 },
				"emojiDownloadTitle": { "type": "string", "minLength": 1 },
				"emojiFrontAlt": { "type": "string", "minLength": 1 },
				"emojiAngledAlt": { "type": "string", "minLength": 1 }
			}
		},
		"footer": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"inspiredByHeading", "alsoAvailable", "sourcePrefix", "sourceSuffix",
				"createdByPrefix", "createdBySuffix", "disclaimer"
			],
			"properties": {
				"inspiredByHeading": { "type": "string", "minLength": 1 },
				"dontAskToAsk": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"text": { "type": "string", "minLength": 1 },
						"hrefPostfix": { "type": "string", "minLength": 1 }
					}
				},
				"noHello": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"text": { "type": "string", "minLength": 1 },
						"hrefPostfix": { "type": "string", "minLength": 1 }
					}
				},
				"alsoAvailable": { "type": "string", "minLength": 1 },
				"sourcePrefix": { "type": "string", "minLength": 1 },
				"sourceSuffix": { "type": "string", "minLength": 1 },
				"createdByPrefix": { "type": "string", "minLength": 1 },
				"createdBySuffix": { "type": "string", "minLength": 1 },
				"disclaimer": { "type": "string", "minLength": 1 }
			}
		}
	}
}
